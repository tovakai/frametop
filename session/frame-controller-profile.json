{
  "note": "Installed with the Hyprland desktop. Trigger is the modifier. controller_in_games stays false so these chords are not active in a game. Rollback restores the previous input rules file.",
  "controller_in_games": false,
  "controller_chords": {
    "modifier": "right/trigger",
    "swallow_click": "right/thumbstick",
    "normal": {
      "right/x": "command:frame-desktop-action.sh workspace-prev",
      "right/b": "command:frame-desktop-action.sh workspace-next",
      "right/a": "command:frame-desktop-action.sh window-next",
      "right/y": "command:frame-desktop-action.sh window-prev"
    },
    "modified": {
      "right/a": "command:frame-desktop-action.sh files",
      "right/b": "command:frame-desktop-action.sh browser",
      "right/x": "command:frame-desktop-action.sh terminal",
      "right/y": "command:frame-desktop-action.sh launcher",
      "right/thumbstick": "command:frame-desktop-action.sh close"
    }
  }
}
